# Headers for static files on Cloudflare Workers Static Assets (the Worker itself never sees these requests).
# Responses made by the Worker (/api/*, /sitemap.xml) get the security headers in worker/src/index.js.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Admin entry pages: kept out of search engines and caches.
/drdaina
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/drdaina/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/d4daina
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/d4daina/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
