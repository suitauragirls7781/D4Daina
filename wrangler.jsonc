// Cloudflare Worker "d4daina": the store's API (api/** behind a small adapter, data in D1) plus the
// built storefront as static assets. Cloudflare's Git build runs `npx wrangler deploy` from the repo root,
// which first runs the build command below.
{
  "name": "d4daina",
  "main": "worker/src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The storefront for Cloudflare: Firebase SDK imports resolve to src/shims (see vite.config.ts)
  "build": { "command": "npm run build:cf" },

  // api/** still imports firebase-admin; these stand-ins run it on D1 and our own tokens
  "alias": {
    "firebase-admin/app": "./worker/src/shims/firebase-admin-app.js",
    "firebase-admin/firestore": "./worker/src/shims/firebase-admin-firestore.js",
    "firebase-admin/auth": "./worker/src/shims/firebase-admin-auth.js"
  },

  "assets": {
    "directory": "./dist-cf",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sitemap.xml"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "suitauragirls-db", "database_id": "bae4a715-99a3-4021-9d42-56843baed258" }
  ],

  // The handlers mark cookies Secure when this is "1"
  "vars": {
    "SECURE_COOKIES": "1",
    // Admin -> Usage & limits (api/_lib/usage.js): which account, database and Worker to read the usage of.
    // These ids are not secret; the API token is the secret CLOUDFLARE_ANALYTICS_TOKEN.
    "CLOUDFLARE_ACCOUNT_ID": "65142a242e92f18ec9db9798f3ac35b4",
    "CLOUDFLARE_D1_ID": "bae4a715-99a3-4021-9d42-56843baed258",
    "CLOUDFLARE_WORKER_NAME": "d4daina",
    // Visitor counting stops for the day at this budget (api/track.js) so orders keep their share of D1's
    // 100,000 rows written a day. Measured on 2 Oct 2026: 8,000 budget units came to about 14,700 rows.
    "TRACK_WRITE_BUDGET": "35000",
    // The plan until the owner uses the switch in Admin -> Usage & limits; once that switch is set, it decides
    // (api/_lib/usage.js). Paid: the page shows the month against what the plan includes, and visitor
    // counting no longer pauses at the free budget.
    "CLOUDFLARE_PLAN": "free"
  },

  // Secrets set on the Worker are kept when the Git build deploys
  "keep_vars": true,

  "observability": { "enabled": true, "logs": { "enabled": true } }
}
